class BarangWarung:

    def __init__(self, nama, harga, stok):
        self.nama = nama
        # Atribut Private (Enkapsulasi)
        self.__harga = harga
        self.__stok = stok

    # --- GETTER ---
    def get_harga(self):
        """Getter untuk mengambil nilai harga"""
        return self.__harga

    def get_stok(self):
        """Getter untuk mengambil nilai stok"""
        return self.__stok

    # --- SETTER ---
    def set_harga(self, harga_baru):
        """Setter untuk mengubah harga dengan validasi (harga > 0)"""
        if harga_baru > 0:
            self.__harga = harga_baru
            print(
                f"[BERHASIL] Harga {self.nama} diperbarui menjadi Rp{self.__harga}"
            )
        else:
            print(
                f"[GAGAL] Input tidak valid! Harga harus lebih besar dari 0."
            )

    def set_stok(self, stok_baru):
        """Setter untuk mengubah stok dengan validasi (stok >= 0)"""
        if stok_baru >= 0:
            self.__stok = stok_baru
            print(f"[BERHASIL] Stok {self.nama} diperbarui menjadi {self.__stok}")
        else:
            print(
                f"[GAGAL] Input tidak valid! Stok tidak boleh negatif ({stok_baru})."
            )


